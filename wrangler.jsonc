{
  // Cloudflare-Worker-Konfiguration.
  // "name" muss genau so heißen wie der Worker im Cloudflare-Dashboard.
  "name": "mmrfc",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
