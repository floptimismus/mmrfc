{
  // Cloudflare-Worker-Konfiguration.
  // "name" muss genau so heißen wie der Worker im Cloudflare-Dashboard.
  "name": "mmrfc",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Datenbank für Konten, Profile und Ergebnisse (wird beim Deploy automatisch angelegt)
  "durable_objects": {
    "bindings": [{ "name": "DB", "class_name": "MonksDB" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MonksDB"] }
  ]
}
